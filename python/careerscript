# 端末側 (-thread)
# ---------------------------------------------------------------------------
def stop_tracker_miner_if_single_session():
    """自分 (assist) のログインがこの ssh セッションだけなら tracker-miner を止める (端末の負荷対策)．
    監視の本筋ではないので，失敗しても無視する"""
    try:
        current_user = getpass.getuser()
        who_output = subprocess.check_output(["who"]).decode("utf-8").strip().splitlines()
        logged_in_users = [line.split()[0] for line in who_output if line.split()]
        my_sessions = [user for user in logged_in_users if user == current_user]
        if len(my_sessions) > 1:
            return
        subprocess.Popen("systemctl --user stop tracker-miner-fs-3.service", shell=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)
    except Exception:
        pass


def is_iso_datetime(text):
    try:
        datetime.datetime.fromisoformat(text)
        return True
    except ValueError:
        return False


def parse_last_line(raw_line, now):
    """last の 1 行を解析してデータ行のフィールド (送信時刻を除く) を返す．対象外の行は None．
    形式が想定外なら ValueError"""
    line = raw_line.strip()
    if not line:
        return None
    # セッションではない行を除外 (異常終了，"gone - no logout"，"wtmp begins ...")
    if "gone - no logout" in line or line.startswith("wtmp begins") or " crash" in line or " down" in line:
        return None
    columns = line.split()
    if len(columns) < 4:
        return None
    user, tty = columns[0], columns[1]
    if user in ("reboot", "shutdown", "runlevel"):
        return None
    if ":" not in tty and "tty" not in tty:  # 実機 (X の :1 や tty) 以外 (pts など) は排除
        return None

    # 3 列目 (接続元ホスト) は tty 切り替えログイン等で空になることがあるので，位置ではなく ISO 時刻を探す
    iso_columns = [column for column in columns[2:] if is_iso_datetime(column)]
    if not iso_columns:
        raise ValueError("login time not found")
    login_str = iso_columns[0]
    login_time = datetime.datetime.fromisoformat(login_str).astimezone(datetime.timezone.utc)

    # ログイン中の表記は "still logged in" と "still running" の両方がある
    if "still" in columns:
        logout_str = LOGGED_IN_MARK
        duration = now - login_time
    else:
        if len(iso_columns) < 2:
            raise ValueError("logout time not found")
        logout_str = iso_columns[1]
        logout_time = datetime.datetime.fromisoformat(logout_str).astimezone(datetime.timezone.utc)
        duration = logout_time - login_time
    using_seconds = str(int(duration.total_seconds()))

    # ex) zw03,:1,2025-04-22T11:50:35+09:00,2025-04-22T12:44:30+09:00,3235,t23cs014
    return [MY_HOSTNAME, tty, login_str, logout_str, using_seconds, user]


def send_to_collector(text):
    """標準出力 (= ssh 経由で収集側) へ送る．接続が切れていたら静かに終了する"""
    try:
        sys.stdout.write(text)
        sys.stdout.flush()
    except (BrokenPipeError, OSError):
        os._exit(0)


def run_terminal_side():
    """端末側の本体．INTERVAL 秒ごとに last の結果をスナップショットとして送り続ける"""
    parent_pid = os.getppid()  # 収集側の ssh が切れると sshd の子から外れて親が変わる
    stop_tracker_miner_if_single_session()
    env = dict(os.environ, LC_ALL="C")  # last の出力言語を固定する (日本語ロケールだと "still logged in" が変わる)

    while True:
        send_buffer = ""
        session_count = 0
        try:
            result = subprocess.run(["last", "-w", "--time-format=iso", "-s", LAST_SINCE],
                                    env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=INTERVAL * 5)
            if result.returncode != 0:
                send_buffer += make_log_line("Error-0x02", "last failed: " + result.stderr.decode("utf-8", "replace").strip())
            last_lines = result.stdout.decode("utf-8", "replace").splitlines()
        except Exception as e:
            send_buffer += make_log_line("Error-0x02", f"last failed: {e}")
            last_lines = []

        now = datetime.datetime.now(datetime.timezone.utc)
        for raw_line in last_lines:  # 1 行の失敗はその行だけ捨てて続ける
            try:
                fields = parse_last_line(raw_line, now)
            except Exception as e:
                send_buffer += make_log_line("Error-0x02", f"{e} / {raw_line}")
                continue
            if fields is None:
                continue
            send_buffer += now_str() + "," + ",".join(fields) + "\n"
            session_count += 1
        send_buffer += f"{now_str()},{MY_HOSTNAME},{KIND_SNAPSHOT_END},{session_count}\n"
        send_to_collector(send_buffer)

        time.sleep(INTERVAL)
        if parent_pid != os.getppid():
            send_to_collector(make_log_line("Error-0x01", "Parent Process is terminated"))
            sys.exit(0)


# ---------------------------------------------------------------------------
# 収集側
# ---------------------------------------------------------------------------
class HostMonitor:
    """端末 1 台分の監視．ssh を張って端末側の出力を読み，最新スナップショットを保持する"""

    def __init__(self, host, collector):
        self.host = host
        self.collector = collector
        self.lock = threading.Lock()
        self.latest_snapshot = None   # 確定済みスナップショット．None=未接続/切断中，[]=接続中でセッションなし
        self.latest_time = 0.0        # スナップショットを受け取った時刻 (time.monotonic)
        self.pending_snapshot = []    # 受信途中のスナップショット (このスレッドしか触らない)
        self.process = None
        self.connected = False
        self.thread = threading.Thread(target=self.run, name=f"monitor-{host}", daemon=True)

    def start(self):
        self.thread.start()

    def run(self):
        remote_command = f"{os.path.abspath(__file__)} -thread -i {INTERVAL}"  # スクリプトは NFS 上にあり端末からも同じパスで見える
        wait = RECONNECT_WAIT
        while True:
            try:
                self.process = subprocess.Popen(["ssh"] + SSH_OPTIONS + [self.host, remote_command],
                                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                                stdin=subprocess.DEVNULL)
                # stderr は stdout にまとめて受け，形式に合わない行としてログに残す (読まずに放置するとパイプが詰まる)
                self.collector.register_process(self.process)
                for raw_line in iter(self.process.stdout.readline, b""):
                    self.handle_line(raw_line.decode("utf-8", "replace").rstrip("\r\n"))
                return_code = self.process.wait()
                if self.connected and not self.collector.shutting_down.is_set():
                    log(f"Error-0x04 : {self.host} is disconnected (rc={return_code})")
            except Exception:
                log(f"Error-0x00 : {self.host} {traceback.format_exc()}")
            finally:
                self.cleanup_process()
                with self.lock:
                    self.pending_snapshot = []
                    self.latest_snapshot = None  # 切断中の端末を「使用中」のまま残さない

            if self.connected:
                self.connected = False
                wait = RECONNECT_WAIT
            else:
                wait = min(wait * 2, RECONNECT_WAIT_MAX)  # 落ちたままの端末には間隔を伸ばして再接続する
            time.sleep(wait)

    def handle_line(self, line):
        fields = line.split(",")
        kind = fields[2] if len(fields) >= 3 else ""
        if kind == KIND_SNAPSHOT_END:
            with self.lock:
                self.latest_snapshot = self.pending_snapshot
                self.latest_time = time.monotonic()
                self.pending_snapshot = []
            if not self.connected:
                self.connected = True
                log(f"Info : {self.host} connected")
        elif kind == KIND_LOG:
            log(f"{self.host} {line}")  # 端末側のプログラムログは収集側のログファイルにだけ残す
        elif len(fields) >= SESSION_FIELD_COUNT:
            self.pending_snapshot.append(fields)
        else:
            log(f"Error-0x03 : {self.host} {line}")  # ssh のエラー出力など，形式に合わない行

    def cleanup_process(self):
        if self.process is None:
            return
        self.collector.unregister_process(self.process)
        if self.process.poll() is None:
            self.process.kill()
        self.process = None

    def take_snapshot(self, now_monotonic, stale_after):
        """出力用に最新スナップショットを返す．切断中は None．更新が途絶えたものは捨てる"""
        with self.lock:
            if self.latest_snapshot is not None and now_monotonic - self.latest_time > stale_after:
                self.latest_snapshot = None  # 接続が固まった端末対策
            return self.latest_snapshot


def parse_session_line(line):
    """seat_output 形式の 1 行から (ユーザ名, ログイン時刻, 利用秒数) を返す．データ行でなければ None"""
    fields = line.strip().split(",")
    if len(fields) < SESSION_FIELD_COUNT:
        return None
    try:
        return fields[6], fields[3], int(fields[5])
    except ValueError:
        return None


def calc_weekly_login(session_lines):
    """直近 1 週間にログインしたセッションの利用秒数をユーザごとに合計する"""
    now = datetime.datetime.now(datetime.timezone.utc)
    week_ago = now - datetime.timedelta(days=7)
    seconds_by_user = collections.defaultdict(int)
    for line in session_lines:
        parsed = parse_session_line(line)
        if parsed is None:
            continue
        user, login_str, using_seconds = parsed
        try:
            login_time = datetime.datetime.fromisoformat(login_str)
        except ValueError:
            continue
        if login_time.tzinfo is None:
            login_time = login_time.replace(tzinfo=datetime.timezone.utc)
        if login_time >= week_ago:
            seconds_by_user[user] += using_seconds
    return seconds_by_user


def write_weekly_login(seconds_by_user, path):
    """ユーザ名,HH:MM:SS の形式で書き出す (並べ替えは JS 側が行う)"""
    lines = []
    for user, total_seconds in sorted(seconds_by_user.items()):
        if not user.startswith("t"):  # 学生 ID (t で始まる) 以外はランキングに載せない
            continue
        hours, remainder = divmod(total_seconds, 3600)
        minutes, seconds = divmod(remainder, 60)
        lines.append(f"{user},{hours:02}:{minutes:02}:{seconds:02}\n")
    write_atomic(path, "".join(lines))


class Collector:
    """収集側の本体．全端末の HostMonitor を束ね，INTERVAL 秒ごとにファイルへ書き出す"""

    def __init__(self, hosts):
        self.monitors = [HostMonitor(host, self) for host in hosts]
        self.processes = []  # 生きている ssh 子プロセス (終了時に片付ける)
        self.processes_lock = threading.Lock()
        self.shutting_down = threading.Event()  # 終了処理中は切断ログを出さない
        self.stale_after = max(30, INTERVAL * 5)  # この秒数を超えて更新のないスナップショットは捨てる

    def register_process(self, process):
        with self.processes_lock:
            self.processes.append(process)

    def unregister_process(self, process):
        with self.processes_lock:
            if process in self.processes:
                self.processes.remove(process)

    def terminate_processes(self):
        with self.processes_lock:
            processes = list(self.processes)
        for process in processes:
            try:
                process.terminate()
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                process.kill()
            except Exception:
                pass

    def handle_signal(self, signum, frame):
        self.shutting_down.set()
        log(f"Info : received signal {signum}, exiting")
        self.terminate_processes()
        os._exit(0)

    def build_seat_output(self):
        """全端末の最新スナップショットを seat_output.txt の行に組み立てる"""
        now_monotonic = time.monotonic()
        lines = []
        for monitor in self.monitors:
            snapshot = monitor.take_snapshot(now_monotonic, self.stale_after)
            if snapshot is None:
                continue  # 切断中の端末は出力しない
            if not snapshot:
                # 接続中だが 1 週間セッションがない端末．PHP は seat_output に現れた端末しか「空き」と判定しないので，
                # ダミー行 (5 列目が時刻でも logged でもない) を出して端末の存在だけ伝える
                lines.append(f"{now_str()},{monitor.host},-,-,-,0,-")
                continue
            lines.extend(",".join(fields) for fields in snapshot)
        return lines

    def write_outputs(self):
        session_lines = self.build_seat_output()
        if args.rank:
            write_weekly_login(calc_weekly_login(session_lines), WEEKLY_LOGIN_PATH)
        text = "Update Time : " + now_str() + "\n"
        if session_lines:
            text += "\n".join(session_lines) + "\n"
        write_atomic(SEAT_OUTPUT_PATH, text)

    def run(self):
        for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
            signal.signal(signum, self.handle_signal)
        atexit.register(self.terminate_processes)

        for monitor in self.monitors:
            monitor.start()
        log(f"Info : collector started (pid={os.getpid()}, hosts={len(self.monitors)}, rank={args.rank})")

        while True:
            time.sleep(INTERVAL)
            try:
                self.write_outputs()
            except Exception:
                log("Error-0x05 : " + traceback.format_exc())  # 書き込み失敗 (NFS 一時障害など) で収集を止めない


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
if args.thread:
    run_terminal_side()
else:
    Collector(HOSTS).run()
