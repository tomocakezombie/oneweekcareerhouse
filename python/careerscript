        my_sessions = [user for user in logged_in_users if user == current_user]    # 自分のユーザー名が複数回出現するか確認
        if len(my_sessions) > 1:
            return
        else:
            service = "systemctl --user stop tracker-miner-fs-3.service "
            subprocess.Popen(service,shell= True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,stdin=subprocess.DEVNULL)
    except Exception:
        pass # 監視の本筋ではないので失敗しても無視する

def is_iso_datetime(text):
    try:
        datetime.datetime.fromisoformat(text)
        return True
    except ValueError:
        return False

def parse_last_line(raw, myhost, now):
    """last の 1 行を解析してデータ行のフィールド(送信時刻を除く)を返す．対象外の行は None"""
    line = raw.strip()
    if not line:
        return None
    # セッションではない行を除外 (再起動，異常終了，"gone - no logout"，"wtmp begins ...")
    if "gone - no logout" in line or line.startswith("wtmp begins") or " crash" in line or " down" in line:
        return None
    parts = line.split()
    if len(parts) < 4:
        return None
    user, tty = parts[0], parts[1]
    if user in ("reboot", "shutdown", "runlevel"):
        return None
    if ":" not in tty and "tty" not in tty: # 実機(X の :1 や tty)以外(pts など)は排除
        return None
    # 3 列目(接続元ホスト)は tty 切り替えログイン等で空になることがあるので，位置ではなく ISO 時刻を探す
    times = [(idx, p) for idx, p in enumerate(parts[2:], start=2) if is_iso_datetime(p)]
    if not times:
        raise ValueError("login time not found")
    login_str = times[0][1]
    logintime = datetime.datetime.fromisoformat(login_str).astimezone(datetime.timezone.utc)
    # ログイン中の表記は "still logged in" と "still running" の両方がある
    if "still" in parts:
        logout_str = "logged"
        delta = now - logintime
    else:
        if len(times) < 2:
            raise ValueError("logout time not found")
        logout_str = times[1][1]
        logouttime = datetime.datetime.fromisoformat(logout_str).astimezone(datetime.timezone.utc)
        delta = logouttime - logintime
    usingtime = str(int(delta.total_seconds()))
    # ex) zw03,:1,2025-04-22T11:50:35+09:00,2025-04-22T12:44:30+09:00,3235,t23cs014
    return [myhost, tty, login_str, logout_str, usingtime, user]

def send(text):
    # SSH クライアント(収集側)へ送る．接続が切れていたら静かに終了する
    try:
        sys.stdout.write(text)
        sys.stdout.flush()
    except (BrokenPipeError, OSError):
        os._exit(0)

# SSH接続先でのデータ取得用
def getData():
    ppid=int(os.getppid()) # 親プロセスのIDを取得(収集側の ssh が切れると親が変わる)
    find_my_sessions() # 現在のユーザーが複数回ログインしているか確認
    myhost = name.split(".")[0]
    env = dict(os.environ, LC_ALL="C") # last の出力言語を固定する(日本語ロケールだと "still logged in" が変わる)
    interval = max(1, int(opt.interval))

    while True: # 一定時間ごとにデータを取得する部分
        senddata = ""
        count = 0
        try:
            proc = subprocess.run(["last", "-w", "--time-format=iso", "-s", LAST_SINCE],
                                  env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=interval*5)
            if proc.returncode != 0:
                senddata += program_log_line("Error-0x02", "last failed: " + proc.stderr.decode("utf-8", "replace").strip())
            who = proc.stdout.decode("utf-8", "replace").splitlines()
        except Exception as e:
            senddata += program_log_line("Error-0x02", f"last failed: {e}")
            who = []

        now = datetime.datetime.now(datetime.timezone.utc)
        for line in who: # 出力結果を解析．1 行の失敗はその行だけ捨てて続ける
            try:
                fields = parse_last_line(line, myhost, now)
            except Exception as e:
                senddata += program_log_line("Error-0x02", f"{e} / {line}")
                continue
            if fields is None:
                continue
            senddata += now_str() + "," + ",".join(fields) + "\n"
            count += 1
        # スナップショットの終わりを知らせる(収集側はこれを受けて置き換える)
        senddata += f"{now_str()},{myhost},{KIND_SNAPSHOT_END},{count}\n"
        send(senddata)

        time.sleep(interval) # 指定された時間待機
        if ppid!=int(os.getppid()): # 収集側の SSH 接続が切れた場合(sshd の子から外れて親が変わる)
            send(program_log_line("Error-0x01", "Parent Process is terminated"))
            sys.exit(0) # プロセスを終了

# ホストにおけるSSH接続管理のためのスレッド
def ssh(host,i,lock):
    whonow_thread=os.path.abspath(__file__)+' -thread -i '+str(opt.interval) # 絶対パスを取得して，SSH接続先で実行するコマンドを作成
    wait = RECONNECT_WAIT
    connected = False
    while True:
        proc = None
        got_snapshot = False
        try:
            # stderr は stdout にまとめて受け，形式に合わない行としてログに残す(読まずに放置するとパイプが詰まる)
            proc=subprocess.Popen(["ssh"] + SSH_OPTIONS + [host, whonow_thread],
                                  stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
            with proclist_lock:
                proclist.append(proc)
            for raw in iter(proc.stdout.readline, b""):
                line = raw.decode('utf-8', 'replace').rstrip("\r\n")
                fields = line.split(",")
                kind = fields[2] if len(fields) >= 3 else ""
                if kind == KIND_SNAPSHOT_END:
                    with lock:
                        latest[i] = pending[i]
                        latest_time[i] = time.monotonic()
                        pending[i] = []
                    if not got_snapshot:
                        got_snapshot = True
                        if not connected:
                            connected = True
                            wait = RECONNECT_WAIT
                            logger(f"Info : {host} connected")
                elif kind == KIND_LOG:
                    logger(f"{host} {line}") # 端末側のプログラムログは収集側のログファイルにだけ残す
                elif len(fields) >= FIELD_DATA_LEN:
                    pending[i].append(fields) # 出力データを格納(pending はこのスレッドしか触らない)
                else:
                    logger(f"Error-0x03 : {host} {line}") # ssh のエラー出力など，形式に合わない行
            rc = proc.wait()
            if connected and not shutting_down.is_set():
                logger(f"Error-0x04 : {host} is disconnected (rc={rc})")
        except Exception:
            logger(f"Error-0x00 : {host} {traceback.format_exc()}")
        finally:
            if proc is not None:
                with proclist_lock:
                    if proc in proclist:
                        proclist.remove(proc)
                if proc.poll() is None:
                    proc.kill()
            with lock:
                pending[i] = []
                latest[i] = [] # 切断中の端末を「使用中」のまま残さない
        if connected:
            connected = False
        else:
            wait = min(wait * 2, RECONNECT_WAIT_MAX) # 落ちたままの端末には間隔を伸ばして再接続する
        time.sleep(wait) # クールダウン時間待機して再接続

def parse_login_data(line):
    # 例: 2025-04-26 17:01:37.180993,zw03,:1,2025-04-22T11:50:35+09:00,2025-04-22T12:44:30+09:00,3235,t23cs014
    try:
        parts = line.strip().split(",")
        if len(parts) < FIELD_DATA_LEN:
            return None
        hostname = parts[1]
        user = parts[6]
        login_time = parts[3]
        logout_time = parts[4]
        using_time = int(parts[5])
        return user, login_time, using_time
    except Exception:
        return None
    
def calc_weekly_login(result_lines):
    now = datetime.datetime.now(datetime.timezone.utc)
    week_ago = now - datetime.timedelta(days=7)
    user_time = collections.defaultdict(int)
    for line in result_lines:
        parsed = parse_login_data(line)
        if not parsed:
            continue
        user, login_time, using_time = parsed
        try:
            login_dt = datetime.datetime.fromisoformat(login_time)
            if login_dt.tzinfo is None:
                login_dt = login_dt.replace(tzinfo=datetime.timezone.utc)
        except Exception:
            continue
        if login_dt >= week_ago:
            user_time[user] += using_time
    return user_time

def write_weekly_login(user_time, filepath):
    out = []
    for user, total_sec in sorted(user_time.items()):
        if not user.startswith("t"):  # 学生 ID (t で始まる) 以外はランキングに載せない
            continue
        hours = total_sec // 3600
        minutes = (total_sec % 3600) // 60
        seconds = total_sec % 60
        out.append(f"{user},{hours:02}:{minutes:02}:{seconds:02}\n")
    write_atomic(filepath, "".join(out))

#情報の収集
def collection():
    lock = [threading.Lock() for _ in hostname] # 端末毎にロックを作成
    th=[] #各スレッド情報を格納するリスト
    stale_after = max(30, opt.interval * 5) # この秒数を超えて更新のないスナップショットは捨てる(接続が固まった端末対策)

    def clean():
        with proclist_lock:
            procs = list(proclist)
        for p in procs:
            try:
                p.terminate()  # プロセスを終了
                p.wait(timeout=2)  # 終了を待つ
            except subprocess.TimeoutExpired:
                p.kill()  # 強制終了
            except Exception:
                pass
    def signal_handler(sig, frame): # SIGHUP/SIGINT/SIGTERM で終了するための関数
        shutting_down.set()
        logger(f"Info : received signal {sig}, exiting")
        clean() # 終了処理を行う
        os._exit(0)

    for sig in [signal.SIGHUP, signal.SIGINT, signal.SIGTERM]:
        signal.signal(sig, signal_handler) # 各シグナルで終了するための設定
    atexit.register(clean)

    for i, host in enumerate(hostname):
        th.append(threading.Thread(target=ssh,args=(host,i,lock[i],),daemon=True))# ssh(host,i)という命令をスレッドを追加
        th[i].start()# 実行

    logger(f"Info : collector started (pid={os.getpid()}, hosts={len(hostname)}, rank={opt.rank})")
    while True:
        time.sleep(opt.interval) # 指定された時間待機
        try:
            result_lines=[]
            now_mono = time.monotonic()
            for i in range(0,len(hostname)): # 各端末ごとに最新スナップショットを取り出す
                with lock[i]:
                    if latest[i] and now_mono - latest_time[i] > stale_after:
                        latest[i] = []
                    snapshot = latest[i]
                result_lines += [",".join(fields) for fields in snapshot]

            if opt.rank:
                user_time = calc_weekly_login(result_lines)
                write_weekly_login(user_time, output_weekly_login_path)

            result="Update Time : "+now_str()+"\n" # 時間を出しつつ，結果を表示
            if result_lines:
                result += "\n".join(result_lines)+"\n"
            write_atomic(output_file_path, result)
        except Exception:
            logger("Error-0x05 : "+traceback.format_exc()) # 書き込み失敗(NFS 一時障害など)で収集を止めない

def logger(text:str):
    try:
        with open(output_log_file_path, "a") as f:
            f.write(f"[{now_str()}] {text}\n")
    except Exception:
        pass

# main部分
if opt.thread:
    getData()
else:
    collection()
