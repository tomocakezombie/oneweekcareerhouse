def now_str():
    # PHP 側が 'Y-m-d H:i:s.u' でパースするので，マイクロ秒を必ず 6 桁で出す
    return datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")

def program_log_line(code, message):
    # メッセージ中のカンマや改行は行の形式を壊すので潰す
    message = str(message).replace(",", ";").replace("\r", " ").replace("\n", " ")
    return f"{now_str()},{name.split('.')[0]},{KIND_LOG},{code} : {message}\n"

def write_atomic(path, text):
    # 一時ファイルに書いてから rename する．読み手(PHP/JS)が書き込み途中の空ファイルを見ないようにする
    try:
        mode = os.stat(path).st_mode & 0o777 # 既存ファイルの権限を引き継ぐ(umask 077 でも公開可能なまま)
    except FileNotFoundError:
        mode = 0o644
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, path)

def find_my_sessions():
