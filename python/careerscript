# ---------------------------------------------------------------------------
# 端末側 -> 収集側 の 1 行の形式 (カンマ区切り)
#   データ行 : 送信時刻,端末名,tty,ログイン時刻,ログアウト時刻または logged,利用秒数,ユーザ名
#   ログ行   : 送信時刻,端末名,Program Log,Error-0xNN : メッセージ
#   区切り行 : 送信時刻,端末名,Snapshot End,データ行数
# 収集側は区切り行を受けた時点で，その端末のデータをそれまでに届いた行で丸ごと置き換える
# ---------------------------------------------------------------------------
SESSION_FIELD_COUNT = 7
KIND_LOG = "Program Log"
KIND_SNAPSHOT_END = "Snapshot End"
LOGGED_IN_MARK = "logged"  # ログイン中のセッションのログアウト時刻欄に入る値 (PHP が参照する)


# ---------------------------------------------------------------------------
# 共通ユーティリティ
# ---------------------------------------------------------------------------
def now_str():
    """現在時刻の文字列．PHP が 'Y-m-d H:i:s.u' でパースするのでマイクロ秒を必ず 6 桁で出す"""
    return datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")


def make_log_line(code, message):
    """端末側が収集側に送るログ行を作る．カンマや改行は行の形式を壊すので潰す"""
    message = str(message).replace(",", ";").replace("\r", " ").replace("\n", " ")
    return f"{now_str()},{MY_HOSTNAME},{KIND_LOG},{code} : {message}\n"


def write_atomic(path, text):
    """一時ファイルに書いてから rename する．読み手 (PHP/JS) が書き込み途中の空ファイルを見ないようにする"""
    try:
        mode = os.stat(path).st_mode & 0o777  # 既存ファイルの権限を引き継ぐ (umask 077 でも公開可能なまま)
    except FileNotFoundError:
        mode = 0o644
    tmp_path = f"{path}.{os.getpid()}.tmp"
    with open(tmp_path, "w", encoding="utf-8") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp_path, mode)
    os.replace(tmp_path, path)


def log(text):
    """収集側のログファイルに追記する．ログが書けなくても収集は止めない"""
    try:
        with open(LOG_PATH, "a") as f:
            f.write(f"[{now_str()}] {text}\n")
    except Exception:
        pass


